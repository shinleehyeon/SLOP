NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
DOCS_ENABLED=true

DATABASE_URL=postgresql://user:password@localhost:5432/sunrinthon?schema=public
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/sunrinthon?schema=public

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_EXPIRES_IN=14d

GOOGLE_OAUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/api/oauth/google/callback
GITHUB_OAUTH_ENABLED=true
GITHUB_OAUTH_CLIENT_ID=replace-with-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/oauth/github/callback
OAUTH_ALLOWED_REDIRECT_URLS=http://localhost:3000/auth/callback,http://localhost:5173/auth/callback,myapp://oauth/callback

# none | email | sms
VERIFICATION_CHANNEL=none
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RATE_LIMIT_TTL_SECONDS=3600
VERIFICATION_RATE_LIMIT_MAX_ATTEMPTS=3
RESEND_API_KEY=
EMAIL_FROM=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

REDIS_URL=redis://localhost:6379

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=replace-with-s3-bucket
AWS_S3_ENDPOINT_URL=https://1283ebb23bfc96b026b5588ea085c7b5.r2.cloudflarestorage.com
AWS_S3_PUBLIC_URL=https://replace-with-public-file-domain
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_UPLOAD_EXPIRES_SECONDS=900
S3_TEMPORARY_FILE_EXPIRES_HOURS=24

# Sentry (비우면 비활성)
SENTRY_DSN=

OPENROUTER_API_KEY=replace-with-openrouter-api-key

AI_SERVICE_API_KEY=replace-with-at-least-32-character-ai-service-key
AI_SERVICE_BASE_URL=http://127.0.0.1:8000

# http(s) scheme optional — missing scheme defaults to https://
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=replace-with-meili-master-key
MEILI_INDEX_PREFIX=
